# Copy to .env.local (gitignored) and fill in. Never commit real tokens.
# Public token from https://console.mapbox.com/account/access-tokens/
VITE_MAPBOX_TOKEN=

# Supabase dashboard > Project Settings > API Keys. Use the publishable (or legacy
# anon) key only, never the secret/service_role key. Leave blank to run offline
# on sample alerts.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
